<script nonce="iV5GEwRAHP9Bq71PSMWPLeKO">
.btn-wrapper {
  display: flex;
  gap: 16px;
  justify-content: center;
  align-items: center;
}

.btn {
  min-width: 120px;
  padding: 12px 28px;
  text-align: center;
  font-weight: 700;
  font-family: Arial, sans-serif;
  color: #fff;
  border-radius: 999px;
  text-decoration: none;
  transition: all 0.3s ease;
  box-shadow: 0 8px 20px rgba(0,0,0,0.2);
}

/* LOGIN - Biru */
.btn.login {
  background: linear-gradient(135deg, #1d3cff, #2f5bff);
}

/* DAFTAR - Merah ke Biru */
.btn.daftar {
  background: linear-gradient(135deg, #ff3b3b, #4f7cff);
}

/* Hover Effect */
.btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 25px rgba(0,0,0,0.25);
}


    <div class="btn-wrapper">
  <a href="#" class="btn login">LOGIN</a>
  <a href="#" class="btn daftar">DAFTAR</a>
</div>

